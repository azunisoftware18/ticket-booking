generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// USER
model User {
  id       String  @id @default(uuid())
  fullName String  @map("full_name")
  role     String  @default("USER")
  email    String  @unique
  password String?

  refreshToken String?  @map("refresh_token")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")

  tickets Ticket[]

  @@map("users")
}

model Place {
  id       String  @id @default(uuid())
  name     String
  location String?

  latitude  Float?
  longitude Float?

  shortDescription String?
  description      String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]

  slotTemplates SlotTemplate[]
  slotOverrides SlotOverride[]

  @@unique([name, location])
}

// SLOT
model SlotTemplate {
  id      String @id @default(uuid())
  placeId String

  startTime String
  endTime   String
  capacity  Int

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, startTime])
}

model SlotOverride {
  id String @id @default(uuid())

  placeId   String
  date      DateTime
  startTime String

  capacity Int?
  isClosed Boolean @default(false)

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, date, startTime])
}

// TICKET TYPES
model TicketType {
  id      String @id @default(uuid())
  name    String // Adult, Child, Foreign
  price   Float
  placeId String @map("place_id")

  maxPerBooking Int @default(6)

  createdAt DateTime @default(now()) @map("created_at")

  place   Place    @relation(fields: [placeId], references: [id])
  tickets Ticket[]

  @@index([placeId])
  @@map("ticket_types")
}

// TICKET
model Ticket {
  id String @id @default(uuid())

  userId       String   @map("user_id")
  placeId      String   @map("place_id")
  slotDateTime DateTime @map("slot_datetime") //(pass ke liye null)
  typeId       String   @map("type_id")

  bookingType BookingType @default(TICKET)

  qrCode String @unique @map("qr_code")

  status TicketFlowStatus @default(PENDING)

  // PASS SUPPORT
  validFrom   DateTime?
  validTill   DateTime?
  maxEntries  Int?
  usedEntries Int       @default(0)

  entryGateId String? @map("entry_gate_id")
  exitGateId  String? @map("exit_gate_id")

  entryAt DateTime? @map("entry_at")
  exitAt  DateTime? @map("exit_at")

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id])
  place Place      @relation(fields: [placeId], references: [id])
  type  TicketType @relation(fields: [typeId], references: [id])

  scanLogs ScanLog[]

  @@index([qrCode])
  @@index([userId])
  @@index([placeId])
  @@index([slotDateTime])
  @@map("tickets")
}

// GATE
model Gate {
  id   String   @id @default(uuid())
  name String
  type GateType

  // optional geo
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("gates")
}

// SCAN LOG
model ScanLog {
  id String @id @default(uuid())

  ticketId String   @map("ticket_id")
  gateId   String   @map("gate_id")
  type     GateType

  scannedAt DateTime @default(now()) @map("scanned_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("scan_logs")
}

// ENUMS
enum TicketFlowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum GateType {
  ENTRY
  EXIT
}

enum BookingType {
  TICKET
  PASS
}
