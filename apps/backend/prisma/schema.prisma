generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// USER
model User {
  id       String  @id @default(uuid())
  fullName String  @map("full_name")
  role     String  @default("USER")
  email    String  @unique
  password String?

  refreshToken String?  @map("refresh_token")
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")

  tickets  Ticket[]
  bookings Booking[]

  @@map("users")
}

model Place {
  id       String  @id @default(uuid())
  name     String
  location String?

  latitude  Float?
  longitude Float?

  shortDescription String?
  description      String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]

  slotTemplates SlotTemplate[]
  slotOverrides SlotOverride[]
  bookings      Booking[]

  @@unique([name, location])
  @@map("places")
}

// SLOT
model SlotTemplate {
  id      String @id @default(uuid())
  placeId String

  startTime String
  endTime   String
  capacity  Int

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, startTime])
}

model SlotOverride {
  id String @id @default(uuid())

  placeId   String
  date      DateTime
  startTime String

  capacity Int?
  isClosed Boolean @default(false)

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, date, startTime])
}

model Booking {
  id String @id @default(uuid())

  userId String?

  placeId      String
  slotDateTime DateTime

  // CUSTOMER DETAILS
  name  String
  email String
  phone String

  totalAmount Float
  status      String @default("PENDING") // PENDING, PAID, FAILED

  txnId     String? @map("txn_id") // system txn id
  paymentId String? @map("payment_id") // provider txn id

  createdAt DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id])
  place Place @relation(fields: [placeId], references: [id])

  tickets Ticket[]

  @@index([placeId, status, txnId])
  @@map("bookings")
}

// TICKET TYPES
model TicketType {
  id      String @id @default(uuid())
  name    String @unique // Adult, Child, Foreign
  price   Float
  placeId String @map("place_id")

  maxPerBooking Int @default(6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  place   Place    @relation(fields: [placeId], references: [id])
  tickets Ticket[]

  @@unique([name, placeId])
  @@index([placeId])
  @@map("ticket_types")
}

// TICKET
model Ticket {
  id String @id @default(uuid())

  bookingId String  @map("booking_id")
  userId    String? @map("user_id")
  placeId   String  @map("place_id")

  slotDateTime DateTime @map("slot_date_time")
  typeId       String   @map("type_id")

  qrCode String @unique @map("qr_code")

  status TicketFlowStatus @default(PENDING)

  booking Booking    @relation(fields: [bookingId], references: [id])
  type    TicketType @relation(fields: [typeId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id])
  place     Place     @relation(fields: [placeId], references: [id])
  scanLogs  ScanLog[]

  @@map("tickets")
}

// GATE
model Gate {
  id   String   @id @default(uuid())
  name String
  type GateType

  // optional geo
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("gates")
}

// SCAN LOG
model ScanLog {
  id String @id @default(uuid())

  ticketId String   @map("ticket_id")
  gateId   String   @map("gate_id")
  type     GateType

  scannedAt DateTime @default(now()) @map("scanned_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("scan_logs")
}

// ENUMS
enum TicketFlowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum GateType {
  ENTRY
  EXIT
}

enum BookingType {
  TICKET
  PASS
}
